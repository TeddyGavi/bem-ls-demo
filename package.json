{
  "name": "bem-ls-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive demo for bem-ls",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
