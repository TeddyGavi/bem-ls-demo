{
  "name": "bem-ls demo",
  "image": "mcr.microsoft.com/devcontainers/go:1-1.27-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "teddygavi.bem-ls"
      ]
    }
  },
  postCreateCommand: "go version",
  "forwardPorts": [],
  "remoteUser": "vscode"
}
